# ---------------------------------------------------------------------------
# GeekReel 配置文件
#
# 用法：复制成 .env，按需改，然后重启服务。
#   macOS / Linux : cp .env.example .env
#   Windows       : copy .env.example .env
#
# 全部可以不填 —— 不填就是「本机自用」模式：打开就能用，不需要登录。
# 要让别人也能用，把 VW_MULTI_USER 改成 1（见 docs/SELF-HOST.md）。
# ---------------------------------------------------------------------------

# ========== 1. 基础 ==========

# 站点名。出现在登录页、邮件标题、浏览器标题。改成你自己的品牌名
VW_SITE_NAME=GeekReel

# 监听地址。
#   127.0.0.1 = 只有本机能访问（默认，最安全）
#   0.0.0.0   = 局域网 / 公网能访问（要给服务器用时改这个）
VW_HOST=127.0.0.1

# 端口
VW_PORT=4780

# 数据目录：SQLite 数据库、加密后的模型密钥、发件箱。不填默认 ~/.video-workbench
# 容器里固定 /data
# VW_DATA_DIR=/data

# 资产库默认根目录（用户可在界面里改）。不填默认 ~/VideoWorkbench
# VW_LIBRARY_ROOT=/data/library

# 对外访问地址。用于拼邮件里的重置链接，例如 https://reel.example.com
# 挂了反代、或者用域名访问时，建议填上
# VW_PUBLIC_URL=https://reel.example.com

# ========== 2. 账号（多人使用） ==========

# 1 = 需要登录，数据按账号隔离。对外必须先开这个
VW_MULTI_USER=0

# 1 = 允许自助注册。0 = 只能管理员在「账号管理」里开号
# 第一个注册的账号永远是管理员，不受这一项影响
VW_ALLOW_REGISTER=0

# 邀请码。设了之后注册必须填对才能进。公网部署强烈建议设一个
# VW_REGISTER_CODE=换个只有你知道的字符串

# 登录状态保留天数
VW_SESSION_DAYS=30

# 挂 HTTPS 反代后设 1：cookie 只走加密连接。本地 http 调试时要设 0
VW_SECURE_COOKIE=0

# 注册后必须验证邮箱才能登录。需要先配好下面的 SMTP，否则别开
VW_REQUIRE_EMAIL_VERIFY=0

# ========== 3. 发信（找回密码用，可选） ==========
#
# 不配也能用：用户忘记密码时，管理员在「账号管理」点「重置链接」，
# 把生成的地址复制给对方即可。配了之后「忘记密码」能自己走完。
#
# 支持 465 端口（SSL，国内邮箱常用）和明文端口（25 / 本机 relay）。
# 注意：587 的 STARTTLS 不支持，QQ / 163 请用 465 + 授权码。
#
# VW_SMTP_HOST=smtp.qq.com
# VW_SMTP_PORT=465
# VW_SMTP_USER=you@qq.com
# VW_SMTP_PASS=邮箱里申请到的授权码，不是登录密码
# VW_SMTP_FROM=you@qq.com
# VW_SMTP_TLS=1

# ========== 4. 媒体工具（可选） ==========

# 指定 ffmpeg 路径。不填就用仓库自带 / 系统 PATH 里的
# VW_FFMPEG=/usr/bin/ffmpeg
